<form id="login-demo">
    <heading id="heroTitle" text="Login compartilhado" align="center" marginBottom="20" />
    <text
        id="heroDescription"
        text="Tela montada dinamicamente pela ordem do XML. Use demo@acme.com / 123456."
        align="left"
        marginBottom="16" />
    <field
        id="email"
        type="email"
        label="E-mail"
        placeholder="email"
        required="true"
        maxLength="80"
        pattern="^[^\s@]+@[^\s@]+\.[^\s@]+$"
        align="fill_width"
        marginBottom="12" />
    <field
        id="password"
        type="password"
        label="Senha"
        placeholder="Digite sua senha"
        required="true"
        minLength="6"
        maxLength="32"
        align="fill_width"
        marginBottom="12" />
    <button
        id="submit"
        action="submit"
        label="Entrar"
        align="fill_width" />
    <space id="beforeSubmit" height="4" width="0" />
    <status id="loginStatus" align="left" marginBottom="12" />
    <field
        id="rememberMe"
        type="checkbox"
        label="Manter conectado"
        checked="true"
        align="left"
        marginBottom="16" />
</form>
